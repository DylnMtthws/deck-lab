# Both environments must use the same PostgreSQL authority DSN and config file.
# Supply DSN and mapped provider credentials via platform secrets, never this file.
SABER_AI_ENV=main
SABER_AI_COST_CONFIG=/etc/decklab/ai-cost-config.json
# SABER_AI_COST_DSN supplied privately; requires PostgreSQL, no SQLite fallback.
# Preview uses SABER_AI_ENV=preview and the SAME config and authority DSN.
# Replace placeholder model/prices using conservative verified billing rates;
# prices are integer microdollars per token. authorized=false blocks all spend.
# Provider identifiers must match the configured transport's identifier.

# Central email worker only (main). Reads both environments' shared outbox.
SABER_AI_ALERT_EMAIL=djmatthews93@gmail.com
# Reuse private RESEND_API_KEY, SABER_EMAIL_FROM, SABER_PUBLIC_URL configuration.
# Run: python -m sabermetrics.ai_cost_email (once per minute on main only).
